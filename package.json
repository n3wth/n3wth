{
  "name": "@n3wth/sites",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "site:new": "node scripts/create-site.mjs",
    "check:design": "node scripts/check-site-design.mjs",
    "check:invariants": "node scripts/check-invariants.mjs",
    "icons": "node scripts/site-icons.mjs",
    "social": "node scripts/social-card.mjs",
    "dev": "npm run dev -w @n3wth/portfolio",
    "dev:portfolio": "npm run dev -w @n3wth/portfolio",
    "dev:ui": "node scripts/dev-ui.mjs",
    "dev:skills": "npm run dev -w @n3wth/skills",
    "build": "node scripts/build.mjs",
    "build:cloudflare": "node scripts/build.mjs --cloudflare",
    "build:garden": "node scripts/build.mjs --workspace @n3wth/garden",
    "build:kit": "node scripts/build.mjs --workspace @n3wth/kit",
    "build:portfolio": "node scripts/build.mjs --workspace @n3wth/portfolio",
    "build:r3": "node scripts/build.mjs --workspace @n3wth/r3-web",
    "build:skills": "node scripts/build.mjs --workspace @n3wth/skills",
    "build:ui": "node scripts/build.mjs --workspace @n3wth/ui-docs",
    "build:ui-docs": "node scripts/build.mjs --workspace @n3wth/ui-docs",
    "check": "node --test scripts/affected.test.mjs scripts/vercel-ignore.test.mjs scripts/create-site.test.mjs scripts/check-invariants.test.mjs scripts/build.test.mjs scripts/check-built-metadata.test.mjs scripts/vercel-build.test.mjs scripts/cloudflare-preview.test.mjs scripts/cloudflare-preview-config.test.mjs && node scripts/check-invariants.mjs && node scripts/affected.mjs --all && npm run check:design && npm run check:metadata",
    "check:metadata": "node scripts/check-built-metadata.mjs",
    "check:affected": "node scripts/affected.mjs",
    "check:browser": "playwright test",
    "preview": "npm run preview -w @n3wth/portfolio",
    "changeset": "changeset",
    "release:version": "node scripts/version-ui.mjs",
    "check:package": "node scripts/check-ui-package.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "19.3.0",
    "@types/three": "^0.185.4",
    "jsdom": "27.4.0",
    "opentype.js": "^2.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "satori": "0.33.4",
    "sharp": "0.35.4",
    "vitest": "4.1.11",
    "wawoff2": "^2.0.1",
    "wrangler": "4.134.0"
  },
  "allowScripts": {
    "core-js@3.50.0": true,
    "esbuild@0.27.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.4": true,
    "msw@2.15.0": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260917.1": true,
    "@posthog/cli@0.5.30": true,
    "@posthog/cli@0.14.1": true,
    "@sentry/cli@2.58.6": true
  }
}
