{
  "name": "@n3wth/sites",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "packageManager": "npm@11.19.1",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "site:new": "node scripts/create-site.mjs",
    "check:design": "node scripts/check-site-design.mjs",
    "icons": "node scripts/site-icons.mjs",
    "social": "node scripts/social-card.mjs",
    "dev": "npm run dev -w @n3wth/portfolio",
    "dev:portfolio": "npm run dev -w @n3wth/portfolio",
    "dev:ui": "node scripts/dev-ui.mjs",
    "dev:skills": "npm run dev -w @n3wth/skills",
    "build:skills": "npm run build -w @n3wth/skills",
    "build": "npm run build:ui && npm run build:portfolio && npm run build:kit && npm run build:skills",
    "build:kit": "npm run build -w @n3wth/kit",
    "build:portfolio": "npm run build -w @n3wth/portfolio",
    "build:ui": "npm run build -w @n3wth/ui && npm run build -w @n3wth/ui-docs",
    "check": "node --test scripts/affected.test.mjs scripts/vercel-ignore.test.mjs scripts/create-site.test.mjs && node scripts/affected.mjs --all && npm run check:design",
    "check:affected": "node scripts/affected.mjs",
    "check:browser": "playwright test",
    "preview": "npm run preview -w @n3wth/portfolio"
  },
  "devDependencies": { "@playwright/test": "1.63.0", "@resvg/resvg-js": "2.6.2", "@types/react": "19.2.9", "react": "19.2.7", "satori": "0.33.4", "sharp": "0.35.4" }
}
