{
  "name": "@n3wth/sites",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "content:audit": "node scripts/content/article-audit.mjs",
    "test:content-audit": "node --test scripts/content/article-audit.test.mjs",
    "site:new": "node scripts/workspace/create-site.mjs",
    "check:design": "node scripts/workspace/check-site-design.mjs",
    "test:newsletter": "node --test scripts/migrations/resend-newsletter-import.test.mjs && vitest run --config tests/newsletter/vitest.config.ts",
    "check:invariants": "node scripts/workspace/check-invariants.mjs",
    "icons": "node scripts/assets/site-icons.mjs",
    "social": "node scripts/assets/social-card.mjs",
    "dev": "npm run dev -w @n3wth/portfolio",
    "dev:ui": "node scripts/ui/dev-ui.mjs",
    "build": "node scripts/workspace/build.mjs",
    "build:cloudflare": "node scripts/workspace/build.mjs --cloudflare",
    "build:garden": "node scripts/workspace/build.mjs --workspace @n3wth/garden",
    "build:portfolio": "node scripts/workspace/build.mjs --workspace @n3wth/portfolio",
    "build:r3": "node scripts/workspace/build.mjs --workspace @n3wth/r3-web",
    "build:ui": "node scripts/workspace/build.mjs --workspace @n3wth/ui-docs",
    "build:ui-docs": "node scripts/workspace/build.mjs --workspace @n3wth/ui-docs",
    "check": "node --test scripts/content/article-audit.test.mjs scripts/workspace/affected.test.mjs scripts/workspace/create-site.test.mjs scripts/workspace/check-invariants.test.mjs scripts/workspace/build.test.mjs scripts/content/check-built-metadata.test.mjs scripts/cloudflare/cloudflare-preview.test.mjs scripts/cloudflare/cloudflare-preview-config.test.mjs scripts/cloudflare/deploy-apps.test.mjs && node scripts/workspace/check-invariants.mjs && node scripts/workspace/affected.mjs --all && npm run test:newsletter && npm run check:design && npm run check:metadata",
    "check:metadata": "node scripts/content/check-built-metadata.mjs",
    "check:affected": "node scripts/workspace/affected.mjs",
    "check:browser": "playwright test",
    "preview": "npm run preview -w @n3wth/portfolio",
    "check:package": "node scripts/ui/check-ui-package.mjs",
    "knip": "knip"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@vitejs/plugin-react": "6.1.2",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "19.3.0",
    "gray-matter": "^4.0.3",
    "jsdom": "27.4.0",
    "knip": "^6.38.0",
    "opentype.js": "^2.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "satori": "0.33.4",
    "sharp": "0.35.4",
    "vitest": "4.1.11",
    "vite": "8.3.4",
    "wawoff2": "^2.0.1",
    "wrangler": "4.148.0",
    "yoastseo": "3.6.0"
  },
  "allowScripts": {
    "core-js@3.50.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20261006.1": true
  }
}
