{
  "name": "@n3wth/sites",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "packageManager": "npm@11.19.1",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @n3wth/portfolio",
    "dev:portfolio": "npm run dev -w @n3wth/portfolio",
    "dev:ui": "node scripts/dev-ui.mjs",
    "build": "npm run build:portfolio && npm run build:ui",
    "build:portfolio": "npm run build -w @n3wth/portfolio",
    "build:ui": "npm run build -w @n3wth/ui && npm run build -w @n3wth/ui-docs",
    "check": "node --test scripts/affected.test.mjs && node scripts/affected.mjs --all",
    "check:affected": "node scripts/affected.mjs",
    "check:browser": "playwright test",
    "preview": "npm run preview -w @n3wth/portfolio"
  },
  "devDependencies": { "@playwright/test": "1.63.0" }
}
