{
  "name": "@n3wth/ui",
  "version": "2.1.0",
  "description": "Shared Newth theme and site components built on Astryx",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./og": {
      "types": "./dist/og/index.d.ts",
      "import": "./dist/og/index.js"
    },
    "./site": {
      "types": "./dist/site/index.d.ts",
      "import": "./dist/site/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js"
    },
    "./visuals": {
      "types": "./dist/visuals/index.d.ts",
      "import": "./dist/visuals/index.js"
    },
    "./tailwind-theme.css": "./dist/tailwind-theme.css",
    "./site.css": "./dist/site.css",
    "./fonts/*": "./public/fonts/*",
    "./styles": "./dist/styles.css",
    "./tailwind": "./tailwind.preset.cjs",
    "./theme": "./dist/theme.css"
  },
  "files": [
    "dist",
    "tailwind.preset.cjs",
    "public/fonts/Geist-*.woff2",
    "public/fonts/GeistMono-*.woff2",
    "public/fonts/MonaSans-*.woff2",
    "public/fonts/Satoshi-*.woff2",
    "v0",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "size": "size-limit",
    "prepublishOnly": "npm run build",
    "check": "npm run lint && npm run build && node scripts/check-build.mjs && npm test"
  },
  "dependencies": {
    "@astryxdesign/core": "0.1.6",
    "clsx": "^2.1.1",
    "iconoir-react": "^7.11.0",
    "tailwind-merge": "^3.4.0"
  },
  "peerDependencies": {
    "gsap": "^3.12.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "gsap": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@size-limit/file": "^12.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.37.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.12.0",
    "gsap": "^3.14.2",
    "jsdom": "27.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "size-limit": "^12.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  },
  "keywords": [
    "design-system",
    "react",
    "tailwind",
    "atomic-design"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n3wth/n3wth.git",
    "directory": "packages/ui"
  },
  "homepage": "https://ui.n3wth.com",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
