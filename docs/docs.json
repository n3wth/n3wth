{
  "name": "n3wth / docs",
  "theme": "aspen",
  "colors": {
    "primary": "#08090b",
    "light": "#f2f3f5",
    "dark": "#08090b"
  },
  "favicon": "/favicon.svg",
  "seo": {
    "indexing": "navigable",
    "trailingSlash": false,
    "metatags": {
      "canonical": "https://docs.n3wth.com",
      "robots": "index, follow",
      "og:site_name": "n3wth developer docs"
    },
    "organization": {
      "name": "n3wth",
      "url": "https://n3wth.com",
      "sameAs": ["https://github.com/n3wth"]
    }
  },
  "filterSidebar": true,
  "navbar": {
    "links": [
      { "label": "n3wth.com", "href": "https://n3wth.com" },
      { "type": "github", "href": "https://github.com/n3wth" }
    ]
  },
  "navigation": {
    "groups": [
      {
        "group": " ",
        "pages": [
          "index"
        ]
      },
      {
        "group": "UI",
        "pages": [
          "ui/quickstart",
          "ui/primitives-and-themes",
          "ui/site-compositions",
          "ui/api-and-recipes",
          "ui/troubleshooting"
        ]
      },
      {
        "group": "Skills",
        "pages": [
          "skills/quickstart",
          "skills/installation",
          "skills/authoring",
          "skills/cli"
        ]
      },
      {
        "group": "r3",
        "pages": [
          "r3/quickstart",
          "r3/configuration",
          "r3/mcp",
          "r3/troubleshooting"
        ]
      },
      {
        "group": "Contribute",
        "pages": [
          "workspace",
          "publishing"
        ]
      }
    ]
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "heading": {
      "family": "Suisse",
      "weight": 600
    },
    "body": {
      "family": "Suisse",
      "weight": 400
    }
  }
}
