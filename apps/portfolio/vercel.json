{
  "git": {
    "deploymentEnabled": true
  },
  "ignoreCommand": "node ../../scripts/vercel-ignore.mjs @n3wth/portfolio",
  "installCommand": "node ../../scripts/vercel-install.mjs",
  "buildCommand": "cd ../.. && npm run build:portfolio -- --cache-ui",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/frameworks",
      "destination": "/library",
      "permanent": true
    },
    {
      "source": "/frameworks/",
      "destination": "/library",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/thinking",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/thinking",
      "permanent": true
    },
    {
      "source": "/news",
      "destination": "/thinking",
      "permanent": true
    },
    {
      "source": "/news/",
      "destination": "/thinking",
      "permanent": true
    },
    {
      "source": "/press",
      "destination": "/thinking",
      "permanent": true
    },
    {
      "source": "/press/",
      "destination": "/thinking",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!assets/|fonts/|api/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "trailingSlash": false
}
