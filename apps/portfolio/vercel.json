{
  "ignoreCommand": "node ../../scripts/vercel-ignore.mjs @n3wth/portfolio",
  "installCommand": "cd ../.. && npx --yes npm@11.19.1 ci",
  "buildCommand": "cd ../.. && npm run build --workspace @n3wth/ui && npm run build --workspace @n3wth/portfolio",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/frameworks",
      "destination": "/library",
      "permanent": true
    },
    {
      "source": "/frameworks/",
      "destination": "/library",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/thinking",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/thinking",
      "permanent": true
    },
    {
      "source": "/news",
      "destination": "/thinking",
      "permanent": true
    },
    {
      "source": "/news/",
      "destination": "/thinking",
      "permanent": true
    },
    {
      "source": "/press",
      "destination": "/thinking",
      "permanent": true
    },
    {
      "source": "/press/",
      "destination": "/thinking",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/consent",
      "destination": "/consent.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "trailingSlash": false
}
