{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "n3wth-portfolio",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "n3wth.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS"
  },
  // RESEND_API_KEY is a Worker secret. Previews replace all newsletter destinations.
  "vars": {
    "SUBSCRIBE_ENVIRONMENT": "production",
    "RESEND_WELCOME_TEMPLATE_ID": "68d8d7db-2025-41cf-94e0-31bd07537b19",
    "RESEND_WELCOME_FROM": "Oliver Newth <hey@n3wth.com>",
    "RESEND_SEGMENT_ID": "f786bcec-500c-4959-8d2a-07fa2e51d44f",
    "RESEND_PREVIEW_SEGMENT_ID": "0781dff8-5eac-4986-9766-b58e5dc157ad",
    "RESEND_PREVIEW_TOPIC_ID": "50cbe6b4-0ec5-4f37-a1e2-83be76fbc77a",
    "RESEND_TOPIC_IDS": "{\"home\":\"0dc0a1da-8228-4219-969c-b24de6b6f87a\",\"skills\":\"7314ba68-f8de-439b-aa3f-4feafb620383\",\"garden\":\"5bda5e6c-b4f4-484d-a971-217fccbff057\",\"r3\":\"a8117d35-e1be-4a53-a064-20f26f280f57\",\"ui\":\"0d2f90fd-8b0d-4949-9e1f-20e1713a75f1\"}"
  },
  "ratelimits": [
    {
      "name": "SUBSCRIBE",
      "namespace_id": "2026092101",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
