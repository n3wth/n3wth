{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && npm run build --workspace @n3wth/ui && npm run build --workspace @n3wth/skills",
  "build": { "env": { "NEXT_EXPERIMENTAL_FUNCTION_BUNDLING": "1" } },
  "cleanUrls": true,
  "installCommand": "cd ../.. && npx --yes npm@11.19.1 ci",
  "ignoreCommand": "node ../../scripts/vercel-ignore.mjs @n3wth/skills",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/skill/(algorithmic-art|canvas-design|copywriting|doc-coauthoring|docx|frontend-design|internal-comms|pdf|pptx|skill-creator|slack-gif-creator|theme-factory|webapp-testing|xlsx)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://plausible.io https://elephant.n3wth.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; connect-src 'self' https://plausible.io https://generativelanguage.googleapis.com https://*.supabase.co https://elephant.n3wth.com https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com; img-src 'self' data: https:; font-src 'self'; frame-ancestors 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
