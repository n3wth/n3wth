{
  "dependencies": {
    "@ai-sdk/google": "3.0.24",
    "@gsap/react": "2.1.2",
    "@n3wth/site-config": "*",
    "@n3wth/ui": "*",
    "@neondatabase/serverless": "1.1.0",
    "@next/third-parties": "16.3.5",
    "@sentry/react": "10.75.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "ai": "6.0.50",
    "better-auth": "1.7.5",
    "canvas-confetti": "1.9.4",
    "gsap": "^3.15.0",
    "next": "16.3.5",
    "next-axiom": "1.10.0",
    "posthog-js": "^1.433.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@opennextjs/cloudflare": "1.20.6",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "5.5.28",
    "@vitejs/plugin-react": "5.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "24.x"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --config eslint.config.mjs --max-warnings 0 --no-warn-ignored",
      "vitest related --run"
    ]
  },
  "name": "@n3wth/skills",
  "private": true,
  "scripts": {
    "build": "next build",
    "check": "npm run verify",
    "dev": "next dev --webpack",
    "lint": "eslint --config eslint.config.mjs src app",
    "start": "next start",
    "supabase:push": "npx supabase db push",
    "test": "vitest",
    "test:a11y": "vitest src/test/accessibility.test.ts",
    "test:all": "vitest run src/test",
    "test:coverage": "vitest run --coverage",
    "test:design": "vitest src/test/design-system.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:migration": "playwright test --config playwright.migration.config.ts",
    "test:nav": "vitest src/test/nav.test.ts",
    "test:performance": "vitest src/test/performance.test.ts",
    "test:responsive": "vitest src/test/responsive.test.ts",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run build",
    "verify:supabase": "node scripts/verify-supabase.mjs"
  },
  "type": "module",
  "version": "0.0.2"
}
