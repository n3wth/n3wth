{
  "git": { "deploymentEnabled": false },
  "ignoreCommand": "node ../../scripts/vercel-ignore.mjs @n3wth/ui-docs",
  "buildCommand": "cd ../.. && npm run build:ui-docs -- --cache-ui",
  "outputDirectory": "dist",
  "installCommand": "node ../../scripts/vercel-install.mjs @n3wth/ui-docs",
  "framework": null,
  "cleanUrls": true,
  "redirects": [{ "source": "/docs", "destination": "/docs/getting-started", "permanent": true }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
