{
  "ignoreCommand": "node ../../scripts/vercel-ignore.mjs @n3wth/ui-docs",
  "buildCommand": "cd ../.. && npm run build:ui",
  "outputDirectory": "dist",
  "installCommand": "cd ../.. && npx --yes npm@11.19.1 ci",
  "framework": null,
  "cleanUrls": true,
  "redirects": [{ "source": "/docs", "destination": "/docs/getting-started", "permanent": true }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
