{
  "git": { "deploymentEnabled": false },
  "installCommand": "node ../../scripts/vercel-install.mjs @n3wth/garden",
  "buildCommand": "cd ../.. && npm run build:garden -- --cache-ui",
  "ignoreCommand": "node ../../scripts/vercel-ignore.mjs @n3wth/garden",
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/atomic-notess",
      "destination": "/atomic-notes",
      "permanent": true
    }
  ]
}
