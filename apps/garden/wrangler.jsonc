{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "main": "worker.mjs",
  "name": "n3wth-garden",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "garden.n3wth.com", "custom_domain": true }],
  "vars": { "TARGET_ORIGIN": "https://n3wth.com" }
}
