  },
  "name": "@n3wth/r3-web",
  "private": true,
  "scripts": {
    "analyze": "cross-env ANALYZE=true npm run build",
    "build": "next build --turbopack",
    "check": "npm run test:docs && npm run search:check && npm run typecheck && npm run build",
    "dev": "next dev --turbopack",
    "docs:sync": "node scripts/sync-docs-sources.mjs",
    "perf:test": "lighthouse http://localhost:3000 --output json --output-path ./lighthouse-report.json",
    "search:check": "npm run search:types && node --experimental-strip-types scripts/build-search-index.ts && tsc --project worker/tsconfig.json && node --experimental-strip-types --test worker/search.test.ts",
    "search:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "search:types": "wrangler types --config worker/wrangler.jsonc worker/env.d.ts",
    "start": "next start",
    "test:docs": "node --experimental-strip-types --test lib/docs-content.test.ts lib/docs-search.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "version": "0.1.1"
}
