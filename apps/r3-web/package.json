{
  "dependencies": {
    "gray-matter": "4.0.3",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.9.3",
    "wrangler": "4.148.0"
  },
  "name": "@n3wth/r3-web",
  "private": true,
  "scripts": {
    "docs:manifest": "node scripts/docs-manifest.mjs",
    "docs:sync": "node scripts/sync-docs-sources.mjs",
    "search:check": "npm run search:types && node --experimental-strip-types scripts/build-search-index.ts && tsc --project worker/tsconfig.json && node --experimental-strip-types --test worker/search.test.ts",
    "search:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "search:types": "wrangler types --config worker/wrangler.jsonc worker/env.d.ts",
    "build": "node --check worker.mjs",
    "check": "node --test worker.test.mjs scripts/docs-manifest.test.mjs && npm run test:docs && npm run search:check && npm run build",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "typecheck": "node --check worker.mjs",
    "test:docs": "node --experimental-strip-types --test lib/docs-content.test.ts lib/docs-search.test.ts"
  },
  "version": "0.1.2",
  "type": "module"
}
